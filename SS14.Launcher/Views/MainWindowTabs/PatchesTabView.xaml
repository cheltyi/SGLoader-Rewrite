<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mainWindowTabs="clr-namespace:SS14.Launcher.ViewModels.MainWindowTabs"
             xmlns:global="clr-namespace:"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SS14.Launcher.Views.MainWindowTabs.PatchesTabView"
             Name="PatchesTab">
  <UserControl.Resources>
    <global:PathToFileNameConverter x:Key="PathToFileNameConverter"/>
    <global:BooleanToPreloadConverter x:Key="BooleanToPreloadConverter"/>
    <global:BooleanToOnOffConverter x:Key="BooleanToOnOffConverter"/>
    <global:VerdictToIconGeometryConverter x:Key="VerdictToIconGeometryConverter"/>
    <global:VerdictToIconBrushConverter x:Key="VerdictToIconBrushConverter"/>
    <global:VerdictToTooltipConverter x:Key="VerdictToTooltipConverter"/>
  </UserControl.Resources>

  <Design.DataContext>
    <mainWindowTabs:PatchesTabViewModel />
  </Design.DataContext>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <Grid RowDefinitions="Auto,*">
      <TabControl Grid.Row="0">
        <TabItem Header="Patches">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <TextBlock Margin="4, 0" Text="Marseys" Classes="NanoHeadingMedium" />
              <Separator/>

              <ItemsControl ItemsSource="{Binding MarseyPatches}" Name="MarseyPatchList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1" Padding="6,8" Margin="2,0">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <!-- Status icon: green check (approved), amber bang (unknown), red cross (rejected) -->
                        <Path Grid.Column="0" Width="18" Height="18" Margin="4,2,12,0" VerticalAlignment="Top"
                              Stretch="Uniform"
                              Data="{Binding Verdict, Converter={StaticResource VerdictToIconGeometryConverter}}"
                              Fill="{Binding Verdict, Converter={StaticResource VerdictToIconBrushConverter}}"
                              ToolTip.Tip="{Binding Verdict, Converter={StaticResource VerdictToTooltipConverter}}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                            <TextBlock Text="{Binding Preload, Converter={StaticResource BooleanToPreloadConverter}}"
                                       Foreground="Gray" Margin="6,0,0,0" IsVisible="{Binding Preload}" />
                            <TextBlock Text="blocked" Foreground="#F44336" FontWeight="Bold" Margin="6,0,0,0"
                                       IsVisible="{Binding !Allowed}" />
                          </StackPanel>
                          <TextBlock Text="{Binding Desc}" Foreground="Gray" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Asmpath, Converter={StaticResource PathToFileNameConverter}}"
                                     Foreground="#777777" FontSize="11" />
                          <!-- SHA-256 of the patch file; selectable so it can be copied into the repo lists. -->
                          <SelectableTextBlock Text="{Binding Hash}" Foreground="#666666" FontSize="10"
                                               TextWrapping="Wrap" ToolTip.Tip="SHA-256 of this patch file" />
                        </StackPanel>
                        <ToggleButton Grid.Column="2" VerticalAlignment="Center" MinWidth="64" Margin="8,0,4,0"
                                      IsEnabled="{Binding Allowed}"
                                      IsChecked="{Binding Enabled}"
                                      Content="{Binding Enabled, Converter={StaticResource BooleanToOnOffConverter}}"
                                      Command="{Binding DataContext.EnableRefreshCommand, ElementName=MarseyPatchList, FallbackValue={x:Null}}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Sideloading">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <TextBlock Margin="4, 0" Text="Subversion" Classes="NanoHeadingMedium" />
              <Separator/>

              <ItemsControl ItemsSource="{Binding SubverterPatches}" Name="SubverterPatchList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1" Padding="6,8" Margin="2,0">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <!-- Status icon: green check (approved), amber bang (unknown), red cross (rejected) -->
                        <Path Grid.Column="0" Width="18" Height="18" Margin="4,2,12,0" VerticalAlignment="Top"
                              Stretch="Uniform"
                              Data="{Binding Verdict, Converter={StaticResource VerdictToIconGeometryConverter}}"
                              Fill="{Binding Verdict, Converter={StaticResource VerdictToIconBrushConverter}}"
                              ToolTip.Tip="{Binding Verdict, Converter={StaticResource VerdictToTooltipConverter}}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                            <TextBlock Text="blocked" Foreground="#F44336" FontWeight="Bold" Margin="6,0,0,0"
                                       IsVisible="{Binding !Allowed}" />
                          </StackPanel>
                          <TextBlock Text="{Binding Desc}" Foreground="Gray" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Asmpath, Converter={StaticResource PathToFileNameConverter}}"
                                     Foreground="#777777" FontSize="11" />
                          <!-- SHA-256 of the patch file; selectable so it can be copied into the repo lists. -->
                          <SelectableTextBlock Text="{Binding Hash}" Foreground="#666666" FontSize="10"
                                               TextWrapping="Wrap" ToolTip.Tip="SHA-256 of this patch file" />
                        </StackPanel>
                        <ToggleButton Grid.Column="2" VerticalAlignment="Center" MinWidth="64" Margin="8,0,4,0"
                                      IsEnabled="{Binding Allowed}"
                                      IsChecked="{Binding Enabled}"
                                      Content="{Binding Enabled, Converter={StaticResource BooleanToOnOffConverter}}"
                                      Command="{Binding DataContext.EnableRefreshCommand, ElementName=SubverterPatchList, FallbackValue={x:Null}}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Resources" IsVisible="{Binding ShowRPacks}">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <TextBlock Margin="4, 0" Text="Resource packs" Classes="NanoHeadingMedium" />
              <Separator/>

              <ItemsControl ItemsSource="{Binding ResourcePacks}" Name="ResourcePackList">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Width="200" Margin="5">
                      <ToggleButton IsChecked="{Binding Enabled}"
                                    Content="{Binding Name}">
                        <ToolTip.Tip>
                          <StackPanel>
                            <TextBlock Text="{Binding Desc}" />
                            <TextBlock Text="{Binding Dir, Converter={StaticResource PathToFileNameConverter}}" Foreground="Gray"/>
                          </StackPanel>
                        </ToolTip.Tip>
                      </ToggleButton>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
      <StackPanel Orientation="Horizontal" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
        <DockPanel LastChildFill="True">
          <TextBlock Text="Patches are unsandboxed, run at own risk."
                     VerticalAlignment="Bottom" FontWeight="Bold" HorizontalAlignment="Center" DockPanel.Dock="Left"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Open mod directory" Margin="4, 0" Command="{Binding OpenPatchDirectoryCommand}" Height="30"/>
            <Button Content="Recheck mods" Margin="4, 0" Command="{Binding ReloadModsCommand}" Height="30"/>
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
